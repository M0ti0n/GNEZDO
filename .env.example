# Copy to .env and edit. .env is not committed.

# Web port on the server.
GNEZDO_PORT=8080

# Database. Use a NEW database for GNEZDO; never point it at the database of another program (ERP, other nesting software).
# Existing SQL Server on the work server:
GNEZDO_DB=Server=YOUR-SQL-SERVER,1433;Database=gnezdo;User Id=gnezdo;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=False
# With the bundled container (docker compose --profile sqlserver ...):
# GNEZDO_DB=Server=db,1433;Database=gnezdo;User Id=sa;Password=CHANGE_ME_Strong1!;TrustServerCertificate=True;Encrypt=False
SQL_SA_PASSWORD=CHANGE_ME_Strong1!

# PostgreSQL instead of SQL Server: set GNEZDO_DB_KIND=postgres and a PostgreSQL connection.
# GNEZDO_DB_KIND=postgres
# Existing PostgreSQL server (a database and user of GNEZDO's own, see packaging/linux/INSTALL.txt):
# GNEZDO_DB=Host=YOUR-PG-SERVER;Port=5432;Database=gnezdo;Username=gnezdo;Password=CHANGE_ME
# With the bundled container (docker compose --profile postgres ...):
# GNEZDO_DB=Host=pg;Port=5432;Database=gnezdo;Username=gnezdo;Password=CHANGE_ME_Strong1!
PG_PASSWORD=CHANGE_ME_Strong1!

# true = fill an empty database with the sample parts and jobs (for trying it out).
GNEZDO_SAMPLE_DATA=false
