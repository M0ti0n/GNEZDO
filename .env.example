# Copy to .env and edit. .env is not committed.

# Web port on the server.
GNEZDO_PORT=8080

# Database. Use a NEW database for GNEZDO; never point it at the SAOP or Libellula databases.
# Existing SQL Server on the work server:
GNEZDO_DB=Server=YOUR-SQL-SERVER,1433;Database=gnezdo;User Id=gnezdo;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=False
# With the bundled container (docker compose --profile sqlserver ...):
# GNEZDO_DB=Server=db,1433;Database=gnezdo;User Id=sa;Password=CHANGE_ME_Strong1!;TrustServerCertificate=True;Encrypt=False
SQL_SA_PASSWORD=CHANGE_ME_Strong1!

# true = fill an empty database with the sample parts and jobs (for trying it out).
GNEZDO_SAMPLE_DATA=false
